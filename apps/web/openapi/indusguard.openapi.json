  "info": {
    "summary": "Runtime genérico para agentes conectados a APIs OpenAPI",
    "title": "IndusGuard API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/connectors": {
      "get": {
        "description": "Lista integrações disponíveis sem revelar credenciais ou URLs resolvidas.",
        "operationId": "list_connectors_api_v1_connectors_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConnectorSummary"
                  },
                  "title": "Response List Connectors Api V1 Connectors Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Connectors",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/v1/connectors/{connector_id}/operations": {
      "get": {
        "description": "Mostra as operações e políticas públicas de um conector específico.",
        "operationId": "list_operations_api_v1_connectors__connector_id__operations_get",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "title": "Connector Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OperationSummary"
                  },
                  "title": "Response List Operations Api V1 Connectors  Connector Id  Operations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Operations",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/v1/evaluations/latest": {
      "get": {
        "description": "Retorna a avaliação mais recente sem corpus, golden, mensagens ou evidências brutas.",
        "operationId": "latest_evaluation_api_v1_evaluations_latest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicEvaluationDashboard"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Latest Evaluation",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Liveness: confirma apenas que o processo HTTP consegue responder.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/playground/config": {
      "get": {
        "description": "Expõe capacidades públicas sem token, chave do modelo ou configuração interna.",
        "operationId": "playground_config_api_v1_playground_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicPlaygroundConfig"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Playground Config",
        "tags": [
          "playground"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "description": "Confirma catálogo, banco migrado e host público quando ele está habilitado.",
        "operationId": "ready_api_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/runs": {
      "post": {
        "description": "Entrega uma solicitação ao host profundo sem construir claims na camada HTTP.",
        "operationId": "create_public_run_api_v1_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicRunResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Public Run",
        "tags": [
          "playground"
        ]
      }
    },
    "/api/v1/runs/{run_id}/trace": {
      "get": {
        "description": "Expõe a timeline operacional sem carregar conteúdo livre do armazenamento interno.",
        "operationId": "run_trace_api_v1_runs__run_id__trace_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
