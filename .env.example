# Copie este arquivo para .env somente no ambiente local.
# O .env real está ignorado pelo Git e nunca deve ser commitado.

# Configurações do próprio runtime IndusGuard.
INDUSGUARD_ENVIRONMENT=development
# "simulate" impede chamadas mutáveis reais. Use "execute" apenas em ambiente controlado.
INDUSGUARD_EXECUTION_MODE=simulate
INDUSGUARD_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Caminho relativo à raiz quando a aplicação é iniciada pelos comandos do Makefile.
INDUSGUARD_CONNECTORS_DIR=./connectors

# Persistência local gratuita. A URL Neon atual deve preservar
# ?sslmode=require&channel_binding=require; o backend usa Psycopg 3 assíncrono.
INDUSGUARD_DATABASE_URL=sqlite+aiosqlite:///./.data/indusguard.db
INDUSGUARD_PERSIST_RUNS=true

# Playground exclusivo do proprietário. Ative somente depois de criar um token aleatório com
# pelo menos 32 caracteres. O navegador o guarda em sessionStorage, nunca em NEXT_PUBLIC_*.
INDUSGUARD_PUBLIC_RUNS_ENABLED=false
INDUSGUARD_PUBLIC_CONNECTOR_IDS=["synthetic"]
INDUSGUARD_OWNER_TOKEN=
INDUSGUARD_PUBLIC_RUN_RATE_LIMIT_PER_HOUR=3
INDUSGUARD_PUBLIC_RUN_CONCURRENCY=2

# Trace local JSONL. A pasta .data/ é ignorada pelo Git.
INDUSGUARD_TRACE_JSONL_ENABLED=true
INDUSGUARD_TRACE_JSONL_PATH=.data/traces.jsonl

# OTLP/Grafana Cloud é opcional. Não versione headers ou credenciais reais.
INDUSGUARD_OTLP_ENABLED=false
INDUSGUARD_OTLP_ENDPOINT=
INDUSGUARD_OTLP_HEADERS=
INDUSGUARD_TELEMETRY_SERVICE_NAME=indusguard-api

# O agente usa somente a faixa gratuita da Groq com openai/gpt-oss-20b.
# Crie a chave no console da Groq e nunca a versione. Sem ela, os testes offline continuam normais.
GROQ_API_KEY=
INDUSGUARD_GROQ_MODEL=openai/gpt-oss-20b
INDUSGUARD_GROQ_TIMEOUT_SECONDS=20
INDUSGUARD_GROQ_MAX_RETRIES=1
INDUSGUARD_GROQ_MAX_TOKENS=2048
# Somente o piloto eval usa este intervalo conservador entre inícios de chamadas Groq.
INDUSGUARD_EVAL_GROQ_MIN_REQUEST_INTERVAL_SECONDS=60

# Fallbacks opt-in exclusivos do piloto. A ordem é significativa e fica vinculada ao manifesto.
# EloAgents precisa fornecer um endpoint OpenAI-compatible e o ID técnico do modelo; o rótulo
# mostrado na interface (por exemplo, "Gemini 3.1 Pro (Preview)") pode não ser esse ID.
INDUSGUARD_EVAL_FALLBACK_PROVIDERS=
ELOAGENTS_API_KEY=
INDUSGUARD_EVAL_ELOAGENTS_BASE_URL=
INDUSGUARD_EVAL_ELOAGENTS_MODEL=
# Endpoint nativo documentado pelo Google. Confirme a disponibilidade do modelo para sua chave.
GEMINI_API_KEY=
INDUSGUARD_EVAL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
INDUSGUARD_EVAL_GEMINI_MODEL=gemini-3.1-flash-lite
INDUSGUARD_EVAL_GEMINI_REASONING_EFFORT=minimal
# Uma tentativa curta adicional absorve 503 transitório sem ultrapassar o orçamento da run.
INDUSGUARD_EVAL_FALLBACK_TIMEOUT_SECONDS=30
INDUSGUARD_EVAL_FALLBACK_MAX_RETRIES=1
INDUSGUARD_EVAL_FALLBACK_MAX_TOKENS=2048

# URLs dos conectores são resolvidas pelo ambiente e conferidas contra a allowlist do profile.
TRACTIAN_API_URL=http://localhost:8000
SYNTHETIC_API_URL=http://localhost:9000

# Credenciais de conectores pertencem somente ao ambiente e nunca ao profile.yaml.
# EXAMPLE_API_KEY=
